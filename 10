import numpy as np
 
rng = np.random.default_rng(42)
data = np.concatenate([rng.normal(0, 1, 300), rng.normal(5, 1.5, 200)])
 
k = 2
mu = np.array([data.min(), data.max()])
var = np.full(k, data.var())
pi = np.full(k, 1 / k)
 
def gaussian(x, mean, variance):
    return np.exp(-(x - mean)**2 / (2 * variance)) / np.sqrt(2 * np.pi * variance)
 
previous = -np.inf
for i in range(1, 201):
    # E-step: responsibility of each cluster for each point
    weighted = np.array([pi[j] * gaussian(data, mu[j], var[j]) for j in range(k)])
    total = weighted.sum(axis=0)
    resp = weighted / total
    loglik = np.log(total).sum()
    if abs(loglik - previous) < 1e-6:
        break
    previous = loglik
    # M-step: update parameters
    Nk = resp.sum(axis=1)
    mu = (resp @ data) / Nk
    var = np.array([(resp[j] * (data - mu[j])**2).sum() / Nk[j] for j in range(k)])
    pi = Nk / len(data)
 
print("Iterations:", i)
print("Means:", mu.round(3))
print("Variances:", var.round(3))
print("Weights:", pi.round(3))
